# VaaniForm Environment Configuration

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Whisper.cpp Configuration (Primary Local STT Engine)
WHISPER_EXECUTABLE_PATH=C:\whisper.cpp\build\bin\Release\whisper-cli.exe
WHISPER_MODEL_PATH=C:\whisper.cpp\ggml-base.bin
WHISPER_LANGUAGE=en

# Application Mode
DEBUG=True
ALLOW_MOCK_FALLBACK=True
